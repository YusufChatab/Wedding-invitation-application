# Copy this file to .env.local and fill in from Supabase: Project Settings → API.
# Leave SUPABASE_URL empty to run in demo mode (sample guests, in-memory data).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only needed for the guest import script. Never expose this in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Your deployed address, used to build the links in guest-links.csv.
SITE_URL=http://localhost:3000
